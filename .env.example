# ============================================================
# Travel Rule Compliance Demo — Environment Variables
# Copy this file to .env and fill in your real values.
# All keys below are read by server.js at startup.
# ============================================================

# ─── Notabene: 4 Roles ──────────────────────────────────────
# Each role gets its own OAuth client credentials from Notabene sandbox.
# EA = Entity A (Originator VASP's customer)
# CA = Custodian A (Originating VASP)
# EB = Entity B (Beneficiary VASP's customer)
# CB = Custodian B (Beneficiary VASP)

NOTABENE_EA_CLIENT_ID=
NOTABENE_EA_CLIENT_SECRET=
NOTABENE_EA_DID=did:web:your-workspace-a.sandbox.notabene.id:ae
NOTABENE_EA_WEBHOOK_SECRET=

NOTABENE_CA_CLIENT_ID=
NOTABENE_CA_CLIENT_SECRET=
NOTABENE_CA_DID=did:web:your-custodian-a.sandbox.notabene.id:ca
NOTABENE_CA_WEBHOOK_SECRET=

NOTABENE_EB_CLIENT_ID=
NOTABENE_EB_CLIENT_SECRET=
NOTABENE_EB_DID=did:web:your-workspace-b.sandbox.notabene.id:am
NOTABENE_EB_WEBHOOK_SECRET=

NOTABENE_CB_CLIENT_ID=
NOTABENE_CB_CLIENT_SECRET=
NOTABENE_CB_DID=did:web:your-custodian-b.sandbox.notabene.id:cb
NOTABENE_CB_WEBHOOK_SECRET=

# ─── Sumsub KYC / KYB ───────────────────────────────────────
SUMSUB_APP_TOKEN=
SUMSUB_API_SECRET=
SUMSUB_WEBSDK_SECRET=
WEBHOOK_SECRET=

# ─── Elliptic AML (optional) ────────────────────────────────
ELLIPTIC_KEY=
ELLIPTIC_SECRET=
ELLIPTIC_ENDPOINT=aml-api.elliptic.co
ELLIPTIC_SIGN=HMAC-SHA256

# ─── Blockchain (optional, defaults shown) ──────────────────
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
